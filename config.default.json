    "selftest_wait_seconds": 600.0,
    "selftest_image_dir": "",
    "selftest_settle_seconds": 15.0,
    "orbit_pivot": "auto",
    "idle_gap_seconds": 0.5,
    "selftest_pan": 0.0,
    "selftest_zoom": 0.0,
    "selftest_fit": true
