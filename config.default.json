    "emit_hz": 60,
    "ping_seconds": 5.0,
    "deadzone": 30,
    "full_scale": 350,
    "sensitivity": 1.0,
    "axis_gain": {
      "x": 1.0,
      "y": 1.0,
      "z": 1.0,
      "rx": 1.0,
      "ry": 1.0,
      "rz": 1.0
    },
    "axis_invert": {
      "x": false,
      "y": false,
      "z": false,
      "rx": false,
      "ry": false,
      "rz": false
