[Unit]
Description=Bifrost SpaceMouse bridge for Fusion 360 under Wine
Documentation=https://github.com/EliasJernberg/bifrost
After=spacenavd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 @DAEMON@
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
